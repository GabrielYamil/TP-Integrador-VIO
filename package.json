{
  "name": "vio-marker-fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebXR VIO with fiducial marker correction and Foxglove visualization",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"pnpm --filter @vio/client dev\" \"pnpm --filter @vio/server dev\"",
    "dev:client": "pnpm --filter @vio/client dev",
    "dev:server": "pnpm --filter @vio/server dev",
    "build": "pnpm --filter @vio/client build",
    "start": "pnpm --filter @vio/server start",
    "sim": "pnpm --filter @vio/server sim",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm build && pnpm start",
    "markers": "python tools/generate_markers.py",
    "map:demo": "python tools/make_demo_map.py",
    "cert:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-certs.ps1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
